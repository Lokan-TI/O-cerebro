{
  "name": "RdRecoveryRecord",
  "type": "object",
  "properties": {
    "restore_key": {
      "type": "string"
    },
    "recovery_key": {
      "type": "string"
    },
    "source_entity": {
      "type": "string",
      "enum": [
        "RdLead",
        "RdSyncRun",
        "RdManualMatch"
      ]
    },
    "source_record_id": {
      "type": "string"
    },
    "source_ordinal": {
      "type": "number"
    },
    "source_product": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "description": "C\u00f3pia isolada integral do registro original, incluindo seus IDs e metadados originais. O ID desta c\u00f3pia \u00e9 diferente do original. N\u00e3o \u00e9 consultada pelas telas ou sincroniza\u00e7\u00f5es comerciais."
    }
  },
  "required": [
    "restore_key",
    "recovery_key",
    "source_entity",
    "source_record_id",
    "source_ordinal",
    "content_sha256",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}