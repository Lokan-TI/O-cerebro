{
  "name": "RdApiConnection",
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "enum": [
        "crm",
        "marketing",
        "conversas"
      ]
    },
    "label": {
      "type": "string",
      "description": "Nome exibido da conex\u00e3o"
    },
    "notes": {
      "type": "string"
    },
    "token": {
      "type": "string",
      "description": "Credencial substituta (nunca devolvida \u00e0 interface)"
    },
    "token_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "removed": {
      "type": "boolean",
      "default": false
    },
    "removed_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "product"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}