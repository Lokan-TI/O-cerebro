{
  "name": "GovernanceLog",
  "type": "object",
  "properties": {
    "governance_id": {
      "type": "string",
      "description": "Identificador do registro (ex.: GOV-001)"
    },
    "action_type": {
      "type": "string",
      "description": "CREATE, UPDATE, DELETE, VALIDATE, DEPRECATE, CONFLICT_RESOLUTION"
    },
    "entity_type": {
      "type": "string",
      "description": "Entidade afetada"
    },
    "entity_id": {
      "type": "string",
      "description": "Identificador do objeto afetado"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da a\u00e7\u00e3o de governan\u00e7a"
    },
    "performed_by": {
      "type": "string",
      "description": "Executor"
    },
    "performed_at": {
      "type": "string",
      "description": "Data e hora da execu\u00e7\u00e3o"
    },
    "validation_status": {
      "type": "string",
      "description": "VERIFIED, DISCOVERED, INFERRED, PENDING"
    },
    "impact_level": {
      "type": "string",
      "description": "LOW, MEDIUM, HIGH"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "governance_id",
    "action_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}