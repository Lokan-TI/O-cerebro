{
  "name": "ChurnV4ExecutionLog",
  "type": "object",
  "properties": {
    "execution_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "resolving_source",
        "customer_query",
        "episode_query",
        "normalizing",
        "detail_query",
        "persisting",
        "success",
        "error"
      ],
      "default": "started"
    },
    "step": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "period_start": {
      "type": "string"
    },
    "period_end": {
      "type": "string"
    },
    "inactivity_months": {
      "type": "number",
      "default": 13.0
    },
    "customer_rows": {
      "type": "number",
      "default": 0.0
    },
    "episode_rows": {
      "type": "number",
      "default": 0.0
    },
    "detail_rows": {
      "type": "number",
      "default": 0.0
    },
    "audit_cases": {
      "type": "number",
      "default": 0.0
    },
    "run_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "default": 0.0
    },
    "error_message": {
      "type": "string"
    },
    "context_json": {
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}