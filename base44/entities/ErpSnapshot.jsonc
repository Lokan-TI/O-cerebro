{
  "name": "ErpSnapshot",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "description": "ID da fonte de dados ERP"
    },
    "source_name": {
      "type": "string",
      "description": "Nome da fonte"
    },
    "version": {
      "type": "string",
      "description": "Identificador da vers\u00e3o"
    },
    "run_id": {
      "type": "string",
      "description": "ID da execu\u00e7\u00e3o que gerou o snapshot"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "Vers\u00e3o publicada e ativa"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_date": {
      "type": "string",
      "description": "Data m\u00e1xima encontrada na base"
    },
    "record_count": {
      "type": "number",
      "default": 0
    },
    "kpis": {
      "type": "object",
      "description": "Indicadores pr\u00e9-calculados (financeiros, coorte, reten\u00e7\u00e3o)"
    },
    "by_empresa": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "KPIs por empresa/filial (matriz e filiais)"
    },
    "top_clients": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Top clientes por faturamento"
    },
    "top_vendors": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Top vendedores por faturamento"
    },
    "monthly_revenue": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "S\u00e9rie mensal de faturamento"
    },
    "revenue_by_state": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Distribui\u00e7\u00e3o geogr\u00e1fica de receita"
    },
    "new_clients_monthly": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Novos clientes por m\u00eas"
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Alertas autom\u00e1ticos gerados pela an\u00e1lise"
    },
    "clients_total": {
      "type": "number",
      "default": 0
    },
    "query_count": {
      "type": "number",
      "default": 0
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "source_id",
    "version"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}