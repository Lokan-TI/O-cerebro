{
  "name": "BrainLesson",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "Pergunta original do gestor"
    },
    "sql": {
      "type": "string",
      "description": "Consulta T-SQL que respondeu corretamente"
    },
    "tables": {
      "type": "string",
      "description": "Tabelas usadas, separadas por v\u00edrgula"
    },
    "answer_summary": {
      "type": "string",
      "description": "Resumo curto da resposta entregue"
    },
    "kind": {
      "type": "string",
      "enum": [
        "success",
        "correction",
        "rule"
      ],
      "default": "success",
      "description": "success = consulta validada; correction = ajuste ensinado pelo usu\u00e1rio; rule = regra de neg\u00f3cio informada"
    },
    "correction": {
      "type": "string",
      "description": "Orienta\u00e7\u00e3o escrita pelo usu\u00e1rio para corrigir o entendimento"
    },
    "source_id": {
      "type": "string",
      "description": "Fonte de dados usada"
    },
    "weight": {
      "type": "number",
      "default": 1,
      "description": "Prioridade no aprendizado (corre\u00e7\u00f5es pesam mais)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "question"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}