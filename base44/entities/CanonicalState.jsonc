{
  "name": "CanonicalState",
  "type": "object",
  "properties": {
    "state_id": {
      "type": "string",
      "description": "Identificador do estado (ex.: CS-001)"
    },
    "entity_type": {
      "type": "string",
      "description": "Entidade can\u00f4nica: EQUIPMENT, RECEIVABLE, CONTRACT"
    },
    "state_name": {
      "type": "string",
      "description": "Nome can\u00f4nico do estado"
    },
    "state_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do estado"
    },
    "is_active_state": {
      "type": "boolean",
      "default": false,
      "description": "Estado considerado ativo no ciclo de vida"
    },
    "status": {
      "type": "string",
      "default": "TO_VALIDATE",
      "description": "VERIFIED, TO_VALIDATE"
    }
  },
  "required": [
    "state_id",
    "entity_type",
    "state_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}