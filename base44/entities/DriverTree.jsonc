{
  "name": "DriverTree",
  "type": "object",
  "properties": {
    "tree_id": {
      "type": "string",
      "description": "Identificador da \u00e1rvore (ex.: DT-001)"
    },
    "tree_name": {
      "type": "string"
    },
    "root_metric": {
      "type": "string",
      "description": "M\u00e9trica raiz da decomposi\u00e7\u00e3o"
    },
    "decomposition": {
      "type": "string",
      "description": "JSON descrevendo a \u00e1rvore de drivers"
    },
    "domain": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "DISCOVERED",
      "description": "VERIFIED, INFERRED, DISCOVERED"
    }
  },
  "required": [
    "tree_id",
    "tree_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}