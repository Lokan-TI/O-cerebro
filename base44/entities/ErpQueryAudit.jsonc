{
  "name": "ErpQueryAudit",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Usu\u00e1rio que executou a consulta"
    },
    "user_email": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "description": "Fonte de dados alvo"
    },
    "source_name": {
      "type": "string"
    },
    "query": {
      "type": "string",
      "description": "SQL submetido (ap\u00f3s normaliza\u00e7\u00e3o)"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allowed",
        "blocked",
        "error"
      ],
      "default": "allowed",
      "description": "Resultado do controle de seguran\u00e7a"
    },
    "block_reason": {
      "type": "string",
      "description": "Motivo do bloqueio, quando aplic\u00e1vel"
    },
    "row_count": {
      "type": "number",
      "default": 0
    },
    "truncated": {
      "type": "boolean",
      "default": false
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "query",
    "outcome"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}