{
  "name": "RdManualMatch",
  "type": "object",
  "properties": {
    "identity_key": {
      "type": "string",
      "description": "email:, doc: ou tel: normalizado"
    },
    "decision": {
      "type": "string",
      "enum": [
        "link",
        "no_match"
      ],
      "default": "link"
    },
    "erp_cd_pessoa": {
      "type": "string"
    },
    "erp_nm_pessoa": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    }
  },
  "required": [
    "identity_key",
    "decision"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}