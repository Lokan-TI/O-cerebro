{
  "name": "RdLead",
  "type": "object",
  "properties": {
    "external_key": {
      "type": "string",
      "description": "produto:id externo (chave de upsert)"
    },
    "product": {
      "type": "string",
      "enum": [
        "marketing",
        "crm_deal",
        "crm_contact",
        "conversas"
      ]
    },
    "external_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "document": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "campaign": {
      "type": "string",
      "description": "Campanha / segmenta\u00e7\u00e3o"
    },
    "origin": {
      "type": "string",
      "description": "Origem / canal"
    },
    "stage": {
      "type": "string",
      "description": "Etapa do funil / tabula\u00e7\u00e3o"
    },
    "pipeline": {
      "type": "string"
    },
    "deal_status": {
      "type": "string",
      "description": "open, paused, won, lost"
    },
    "amount": {
      "type": "number"
    },
    "owner": {
      "type": "string"
    },
    "source_created_at": {
      "type": "string"
    },
    "closed_at": {
      "type": "string",
      "description": "Data de fechamento da negocia\u00e7\u00e3o (CRM)"
    },
    "synced_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "identity_email": {
      "type": "string"
    },
    "identity_phone": {
      "type": "string"
    },
    "identity_doc": {
      "type": "string"
    },
    "custom_sisloc_proposal": {
      "type": "string",
      "description": "N\u00ba da proposta/ficha Sisloc informado na negocia\u00e7\u00e3o RD (campo n-proposta-sisloc)"
    },
    "match_status": {
      "type": "string",
      "enum": [
        "pending",
        "matched",
        "manual",
        "ambiguous",
        "unmatched",
        "no_identity",
        "rejected"
      ],
      "default": "pending"
    },
    "match_method": {
      "type": "string"
    },
    "erp_cd_pessoa": {
      "type": "string"
    },
    "erp_nm_pessoa": {
      "type": "string"
    },
    "erp_cd_empresa": {
      "type": "string"
    },
    "erp_receita_total": {
      "type": "number"
    },
    "erp_receita_pos_lead": {
      "type": "number"
    },
    "erp_primeira_nf": {
      "type": "string"
    },
    "erp_candidates": {
      "type": "string"
    },
    "matched_at": {
      "type": "string"
    },
    "products_synced_at": {
      "type": "string",
      "description": "Quando os produtos (plataformas) da negocia\u00e7\u00e3o foram extra\u00eddos"
    },
    "products_count": {
      "type": "number",
      "description": "Quantidade de itens de produto na negocia\u00e7\u00e3o"
    },
    "custom_fields_version": {
      "type": "number"
    },
    "custom_fields_synced_at": {
      "type": "string"
    },
    "custom_demand": {
      "type": "string",
      "description": "Array JSON de demandas \u00fanicas normalizadas; uma negocia\u00e7\u00e3o pode ter v\u00e1rias"
    },
    "custom_demand_state": {
      "type": "string",
      "enum": [
        "filled",
        "empty",
        "absent"
      ]
    },
    "custom_sector": {
      "type": "string"
    },
    "custom_sector_state": {
      "type": "string",
      "enum": [
        "filled",
        "empty",
        "absent"
      ]
    },
    "custom_branch": {
      "type": "string"
    },
    "custom_branch_state": {
      "type": "string",
      "enum": [
        "filled",
        "empty",
        "absent"
      ]
    },
    "custom_urgency": {
      "type": "string"
    },
    "custom_urgency_state": {
      "type": "string",
      "enum": [
        "filled",
        "empty",
        "absent"
      ]
    },
    "custom_awareness": {
      "type": "string"
    },
    "custom_awareness_state": {
      "type": "string",
      "enum": [
        "filled",
        "empty",
        "absent"
      ]
    },
    "custom_rental_term": {
      "type": "string"
    },
    "custom_rental_term_state": {
      "type": "string",
      "enum": [
        "filled",
        "empty",
        "absent"
      ]
    }
  },
  "required": [
    "external_key",
    "product"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}