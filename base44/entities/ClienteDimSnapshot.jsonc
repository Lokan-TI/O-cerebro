{
  "name": "ClienteDimSnapshot",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "description": "ID da fonte de dados ERP"
    },
    "source_name": {
      "type": "string",
      "description": "Nome da fonte"
    },
    "source_slug": {
      "type": "string",
      "description": "Prefixo usado no ID global (Fonte-ID)"
    },
    "version": {
      "type": "string"
    },
    "is_current": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by_name": {
      "type": "string"
    },
    "period_start": {
      "type": "string"
    },
    "period_end": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "query_count": {
      "type": "number",
      "default": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kpis": {
      "type": "object",
      "description": "KPIs consolidados da dimens\u00e3o cliente"
    },
    "by_empresa": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status_distribution": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Linhas da vw_cliente_360 (limitado)"
    },
    "clients_truncated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "source_id",
    "version"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}