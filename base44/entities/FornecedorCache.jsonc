{
  "name": "FornecedorCache",
  "type": "object",
  "properties": {
    "source_key": {
      "type": "string",
      "description": "Fonte ERP (id ou 'all')"
    },
    "cd_pessoa": {
      "type": "string",
      "description": "C\u00f3digo do fornecedor no ERP"
    },
    "erp": {
      "type": "object",
      "description": "Dados originais do ERP na \u00faltima carga"
    },
    "corrections": {
      "type": "object",
      "description": "Campos corrigidos no C\u00e9rebro (n\u00e3o gravados no Sisloc)"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "source_key",
    "cd_pessoa"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}