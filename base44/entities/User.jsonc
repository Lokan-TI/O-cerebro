{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Hierarquia de acesso: admin > gestor > coordenador",
      "enum": [
        "admin",
        "gestor",
        "coordenador",
        "user"
      ]
    },
    "empresa_scope": {
      "type": "number",
      "description": "Empresa (cd_empresa) \u00e0 qual o coordenador est\u00e1 restrito"
    }
  },
  "required": [
    "role"
  ]
}