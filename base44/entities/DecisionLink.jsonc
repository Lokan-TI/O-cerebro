{
  "name": "DecisionLink",
  "type": "object",
  "properties": {
    "link_id": {
      "type": "string",
      "description": "Identificador do v\u00ednculo (ex.: DL-001)"
    },
    "metric_id": {
      "type": "string",
      "description": "Refer\u00eancia ao MetricDefinition (ex.: METRIC-001)"
    },
    "objective": {
      "type": "string",
      "description": "Objetivo de neg\u00f3cio suportado pela m\u00e9trica"
    },
    "risk": {
      "type": "string",
      "description": "Risco caso a m\u00e9trica saia de controle"
    },
    "driver": {
      "type": "string",
      "description": "O que dirige a m\u00e9trica"
    },
    "action": {
      "type": "string",
      "description": "A\u00e7\u00e3o poss\u00edvel quando fora do esperado"
    },
    "trade_off": {
      "type": "string",
      "description": "Trade-off a considerar"
    },
    "benchmark": {
      "type": "string",
      "description": "Benchmark de mercado (loca\u00e7\u00e3o de equipamentos)"
    },
    "priority": {
      "type": "string",
      "description": "IMMEDIATE, SHORT_TERM, MEDIUM_TERM, STRUCTURAL"
    },
    "owner_domain": {
      "type": "string",
      "description": "Dom\u00ednio respons\u00e1vel"
    },
    "confidence": {
      "type": "string",
      "description": "HIGH, MEDIUM, LOW"
    },
    "status": {
      "type": "string",
      "default": "DISCOVERED",
      "description": "VERIFIED, INFERRED_HIGH, DERIVED, DISCOVERED"
    }
  },
  "required": [
    "link_id",
    "metric_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}