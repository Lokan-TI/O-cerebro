{
  "name": "DecisionMemory",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "description": "Identificador da decis\u00e3o (ex.: DEC-001)"
    },
    "decision_date": {
      "type": "string",
      "description": "Data da decis\u00e3o"
    },
    "decision_text": {
      "type": "string",
      "description": "Decis\u00e3o registrada"
    },
    "context": {
      "type": "string",
      "description": "Contexto que originou a decis\u00e3o"
    },
    "evidence": {
      "type": "string",
      "description": "Evid\u00eancia utilizada"
    },
    "alternatives": {
      "type": "string",
      "description": "Alternativas consideradas"
    },
    "selected_option": {
      "type": "string",
      "description": "Op\u00e7\u00e3o escolhida"
    },
    "reason": {
      "type": "string",
      "description": "Racional da escolha"
    },
    "expected_result": {
      "type": "string",
      "description": "Resultado esperado"
    },
    "actual_result": {
      "type": "string",
      "description": "Resultado observado"
    },
    "status": {
      "type": "string",
      "default": "PENDING",
      "description": "PENDING, EXECUTED, COMPLETED, CANCELLED"
    },
    "domain": {
      "type": "string",
      "description": "Dom\u00ednio de neg\u00f3cio"
    },
    "owner": {
      "type": "string",
      "description": "Respons\u00e1vel pela decis\u00e3o"
    },
    "classification": {
      "type": "string",
      "description": "TRANSIENT_ANALYSIS, VALIDATED_INSIGHT, BUSINESS_RULE, DECISION, DECISION_OUTCOME, LEARNED_PATTERN"
    },
    "confidence": {
      "type": "string",
      "description": "HIGH, MEDIUM, LOW"
    }
  },
  "required": [
    "decision_id",
    "decision_text"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}